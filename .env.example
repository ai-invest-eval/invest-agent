OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_CANDIDATES=15
# Agent 1 초기 탐색의 검색어별 페이지 수(1~20). 페이지 수와 기업 수는 다르다.
MAX_DISCOVERY_RESULTS_PER_QUERY=5
# Agent 1 기업 자격 판단 병렬 수(1~3). API 한도가 낮으면 1로 설정.
AGENT1_WORKERS=3
# Agent 1 자격 검증 완화 (1: 확인된 부적격만 탈락, 0: 4대 조건 엄격 검증)
ALLOW_RELAXED_QUALIFY=1

# ── Orchestrator-Workers (Agent 과제) ──
# 병렬 Worker 동시 실행 수 (API rate limit 보호)
WORKER_CONCURRENCY=3
# Tavily 검색 사이 최소 간격(초, 0.5~10). dev 키는 5 권장 — 동시 검색에서 429 차단 방지
TAVILY_MIN_INTERVAL_SECONDS=2
# agent6 내장 Judge 루프 (0: 끔 — 품질 루프는 quality_eval 노드가 담당)
REPORT_INTERNAL_JUDGE=0
# 실패 주입 시연: 이 이름의 기업 Worker를 강제로 실패시킴 (평소엔 비워 둠)
FORCE_FAIL_COMPANY=
# 검색 실패 시 캐시 후보 사용 (1: 켬). 실제 시연에서는 반드시 0 — 켜면 키워드를 바꿔도 같은 후보가 나옴
ALLOW_CACHED_FALLBACK=0

# ── LangSmith 트레이싱 ──
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=invest-agent-orchestrator
